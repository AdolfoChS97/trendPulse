{
  "name": "@trendpulse/db",
  "private": true,
  "version": "0.0.1",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -b",
    "lint": "echo ok",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "db:generate": "tsx node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@trendpulse/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
