{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@trendpulse/shared": ["../../packages/shared/src"],
      "@trendpulse/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "references": [],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
