    "@nestjs/bull": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/jwt": "^11.0.0",
    "bull": "^4.16.5",
    "ioredis": "^5.4.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/express": "^5.0.0",
