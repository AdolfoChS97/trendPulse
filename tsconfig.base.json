{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@trendpulse/shared": ["./packages/shared/src"],
      "@trendpulse/shared/*": ["./packages/shared/src/*"],
      "@trendpulse/db": ["./packages/db/src"],
      "@trendpulse/platform-drivers": ["./packages/platform-drivers/src"],
      "@trendpulse/platform-drivers/*": ["./packages/platform-drivers/src/*"]
    }
  }
}
